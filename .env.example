# Copy into an untracked .env file. All values here are examples only.
# Production must use a NON-owner, NON-superuser, NON-BYPASSRLS runtime role.
DATABASE_URL=postgresql://elhafez_runtime:replace-with-secret@localhost:5432/elhafez
MIGRATION_DATABASE_URL=postgresql://elhafez:replace-with-secret@localhost:5432/elhafez
PORT=4000
REDIS_URL=redis://localhost:6379
# Bootstrap only (NEVER commit actual values):
BOOTSTRAP_TENANT_SLUG=demo-tourism
BOOTSTRAP_TENANT_NAME=Demo Tourism
BOOTSTRAP_EMAIL=owner@example.com
BOOTSTRAP_PASSWORD=replace-with-strong-private-password
# Official Meta WhatsApp Cloud API - configure only in an UNTRACKED secret store.
# Obtain from Meta developer console; never copy live values into Git.
META_GRAPH_VERSION=v24.0
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Base64-encoded 32 random bytes (store securely and preserve for decryption).
WHATSAPP_TOKEN_ENCRYPTION_KEY=

# Platform owner uses a separate, tightly controlled administrative PostgreSQL role.
# It needs authorized access to platform tables and tenant provisioning.
PLATFORM_DATABASE_URL=
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=
