# Copy into an untracked .env file. All values here are examples only.
# Production must use a NON-owner, NON-superuser, NON-BYPASSRLS runtime role.
DATABASE_URL=postgresql://elhafez_runtime:replace-with-secret@localhost:5432/elhafez
MIGRATION_DATABASE_URL=postgresql://elhafez:replace-with-secret@localhost:5432/elhafez
PORT=4000
REDIS_URL=redis://localhost:6379
# Bootstrap only (NEVER commit actual values):
BOOTSTRAP_TENANT_SLUG=demo-business
BOOTSTRAP_TENANT_NAME=Demo Business
BOOTSTRAP_EMAIL=owner@example.com
BOOTSTRAP_PASSWORD=replace-with-strong-private-password
# Official Meta WhatsApp Cloud API - configure only in an UNTRACKED secret store.
# Obtain from Meta developer console; never copy live values into Git.
META_GRAPH_VERSION=v24.0
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Base64-encoded 32 random bytes (store securely and preserve for decryption).
WHATSAPP_TOKEN_ENCRYPTION_KEY=

# Platform owner uses a separate, tightly controlled administrative PostgreSQL role.
# It needs authorized access to platform tables and tenant provisioning.
PLATFORM_DATABASE_URL=
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=

# Optional OpenAI-compatible source selection provider; no key required for core flows.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Exact HTTPS webhook hostnames, comma-separated; empty disables outbound integrations.
OUTBOUND_WEBHOOK_HOSTS=
# Optional HMAC-SHA256 receiver signature. Keep in untracked environment only.
OUTBOUND_WEBHOOK_SIGNING_SECRET=

# HTTPS public origin for managed media links (no trailing slash).
MEDIA_PUBLIC_ORIGIN=
# Independent 32-byte base64 master key for per-integration encrypted Bearer/HMAC secrets.
INTEGRATION_SECRET_ENCRYPTION_KEY=

# Advanced runtime (0024). Generate a separate random secret for distributed IP/user limits.
RATE_LIMIT_SECRET=
# Trust only the internal gateway IP(s); the gateway overwrites forwarded client addresses.
TRUSTED_PROXY_IPS=127.0.0.1,::1,::ffff:127.0.0.1
APP_PUBLIC_ORIGIN=
# Local ClamAV daemon Unix socket. Missing/unavailable scanner keeps uploads PENDING/private.
CLAMAV_SOCKET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Pin an API version supported by your Shopify app, e.g. 2026-10; do not silently use latest.
SHOPIFY_API_VERSION=
# Exact approved WooCommerce hostnames, comma-separated. Public IPv4+DNS pinning required.
WOOCOMMERCE_HOSTS=
# Instagram adapter uses Instagram Login and graph.instagram.com.
META_SOCIAL_APP_SECRET=
META_SOCIAL_VERIFY_TOKEN=
